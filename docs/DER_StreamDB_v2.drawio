="1" parent="1" source="c151" target="c10"><mxGeometry x="0.4" relative="1" as="geometry"/></mxCell><mxCell id="c190" value="Leyenda (DER v2 vs. DER de partida)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="1590" width="320" height="30" as="geometry"/></mxCell><mxCell id="c191" value="Sin cambios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a0c8f0;strokeColor=#000000;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1630" width="180" height="40" as="geometry"/></mxCell><mxCell id="c192" value="Nuevo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe066;strokeColor=#b8860b;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1685" width="180" height="40" as="geometry"/></mxCell><mxCell id="c193" value="Modificado (borde naranja)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a0c8f0;strokeColor=#d6730b;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1740" width="180" height="40" as="geometry"/></mxCell><mxCell id="c194" value="Eliminados: entidad HistorialReproduccion (reemplazada por Visualizacion, que ahora lleva posicionSegundos y finalizado; el estado de continuar viendo vive en Redis y no es entidad), relaciones Controla (Cuenta–SesionActiva) y Registra (Historial–Contenido), atributo Contenido.duracion pasa a ser solo de películas (en series vive en Episodio). Visualizacion apunta siempre a Contenido y, si es serie, a un Episodio (para películas el id de unidad es el idContenido). Licencia vive en PostgreSQL; el resto según matriz-trazabilidad.md." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="1800" width="520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>